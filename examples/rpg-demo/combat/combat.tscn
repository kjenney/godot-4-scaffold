[node name="Defend" type="Button" parent="CombatCanvas/UI/Buttons/GridContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
text = "Defend"

[node name="Flee" type="Button" parent="CombatCanvas/UI/Buttons/GridContainer"]
layout_mode = 2
